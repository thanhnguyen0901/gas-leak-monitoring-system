# Use scripts/configure-local.py to generate a random local password in ignored .env.
POSTGRES_PASSWORD=
# Leave empty to use the local Docker broker; set mqtts://...:8883 for HiveMQ Cloud.
MQTT_URL=mqtt://broker:1883
MQTT_USER=
MQTT_PASSWORD=
NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional ports/origins for local QA; defaults shown in compose.yaml.
# BACKEND_PORT=3000
# FRONTEND_PORT=8080
# POSTGRES_PORT=5432
# BROKER_PORT=1883
# PUBLIC_API_URL=http://localhost:3000
# WEB_ORIGIN=http://localhost:8080
# APP_TOKEN is an optional shared browser-visible read token, not a service secret.
APP_TOKEN=
