{
  "name": "gas-monitor-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "npm run build && node --test dist/test/*.test.js",
    "migrate": "npm run build && node --env-file-if-exists=.env dist/src/migrate.js",
    "test:db": "npm run build && node --test dist/test/postgres.integration.js",
    "test:system": "npm run build && node --test --test-concurrency=1 dist/test/system.integration.js dist/test/notifications.integration.js",
    "test:failure": "npm run build && node --test dist/test/failure.integration.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "mqtt": "^5.10.0",
    "socket.io": "^4.8.1",
    "zod": "^4.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^24.0.0",
    "socket.io-client": "^4.8.1",
    "aedes": "0.51.3",
    "@types/pg": "^8.15.0"
  }
}
