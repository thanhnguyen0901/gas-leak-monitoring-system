HOST=127.0.0.1
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Empty URL disables MQTT for isolated API tests. Use mqtts://...:8883 for HiveMQ Cloud.
MQTT_URL=mqtt://localhost:1883
MQTT_USER=
MQTT_PASSWORD=
# Optional shared read token; configure the same value in frontend locally.
APP_TOKEN=
STALE_AFTER_MS=10000
# Empty DATABASE_URL is explicitly ephemeral memory mode.
DATABASE_URL=
DATABASE_SSL=false
MIGRATE_ON_START=false
# Explicit opt-in; no real Telegram messages are sent by automated tests.
NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATION_COOLDOWN_MS=60000
